NODE_ENV=development
PORT=3000

# PostgreSQL connection string. For a local database you can use:
# postgresql://postgres:password@localhost:5432/campusfind
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:5432/campusfind

# Set this to disable only for a local PostgreSQL server without SSL.
# Render Postgres, Neon, and Supabase should normally keep SSL enabled.
PGSSLMODE=require
PG_POOL_MAX=10

JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d

# Used only by: npm run create-admin
ADMIN_NAME=CampusFind Administrator
ADMIN_EMAIL=admin@uregina.ca
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_PHONE=306-585-4407
